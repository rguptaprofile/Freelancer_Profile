# ==============================================================================
# RENDER BACKEND ENVIRONMENT CONFIGURATION
# Set these Environment Variables in your Render Dashboard (Settings -> Environment)
# ==============================================================================

# Server Port (Render sets this dynamically, default is 5000)
PORT=5000
NODE_ENV=production

# Frontend Client Allowed for CORS
CLIENT_ORIGIN=https://freelancerprofile.vercel.app

# Razorpay Credentials (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id_here
RAZORPAY_KEY_SECRET=your_actual_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Settlement & Business Name
VITE_PAYEE_NAME=Rahul Raj
VITE_RAZORPAY_BUSINESS_NAME=Rahul & Jyoti Studio
