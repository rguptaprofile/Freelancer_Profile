# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (VITE_)
# Read securely in browser using import.meta.env
# ------------------------------------------------------------------------------

# SINGLE PAYMENT GATEWAY: RAZORPAY (Card, UPI, Scan QR, NetBanking, NEFT/IMPS)
# All client transactions are routed exclusively via Razorpay and credited directly to the merchant's bank account.
# Get your keys from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_ENABLED="true"
VITE_RAZORPAY_KEY_ID="rzp_live_your_actual_key_id_here"
VITE_RAZORPAY_BUSINESS_NAME="Rahul & Jyoti Duo Profile"
VITE_PAYEE_NAME="Rahul Raj"

# Mandatory 18% GST (Tax included on client payments)
VITE_GST_RATE="18"

# Backend Render API URL
VITE_BACKEND_URL="https://freelancer-profile-backend.onrender.com"

# Merchant Settlement Bank Record (Linked to Razorpay for automated settlement)
VITE_BANK_BENEFICIARY="Rahul Raj"
VITE_BANK_NAME="State Bank of India"
VITE_BANK_ACCOUNT_TYPE="Savings / Current Account"

# Lead & Payment Notification Channels
VITE_NOTIFICATION_EMAIL="rahulgupt1231@gmail.com"
VITE_SUPPORT_PHONE="+91 6209980667"

# ------------------------------------------------------------------------------
# 2. STRICT BACKEND PRIVATE SECRETS (STRICTLY SERVER-SIDE ONLY)
# These variables NEVER touch the browser or client-side bundles!
# ------------------------------------------------------------------------------

# Server Configuration
PORT="5000"
NODE_ENV="development"
CLIENT_ORIGIN="https://freelancerprofile.vercel.app"

# Razorpay Private Secret (Used ONLY on backend for signature verification)
RAZORPAY_KEY_ID="rzp_live_your_actual_key_id_here"
RAZORPAY_KEY_SECRET="your_actual_secret_key_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"
